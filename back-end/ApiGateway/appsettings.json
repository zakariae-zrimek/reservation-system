{
  "UserService": {
    "BaseUrl": "http://userservice:8080/"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "users",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "images": {
        "ClusterId": "events",
        "Match": { "Path": "/uploads/images/{**catch-all}" }
      },

      "events": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events/{**catch-all}" }
      },

      "rooms": {
        "ClusterId": "events",
        "Match": { "Path": "/api/rooms/{**catch-all}" }
      },

      "reservations": {
        "ClusterId": "reservations",
        "Match": { "Path": "/api/reservations/{**catch-all}" }
      },

      "interests": {
        "ClusterId": "interests",
        "Match": { "Path": "/api/interests/{**catch-all}" }
      }
    },

    "Clusters": {
      "users": {
        "Destinations": {
          "d1": { "Address": "http://userservice:8080/" }
        }
      },
      "events": {
        "Destinations": {
          "d1": { "Address": "http://eventservice:8080/" }
        }
      },
      "reservations": {
        "Destinations": {
          "d1": { "Address": "http://reservationservice:8080/" }
        }
      },
      "interests": {
        "Destinations": {
          "d1": { "Address": "http://userinterestservice:8080/" }
        }
      }
    }
  }
}