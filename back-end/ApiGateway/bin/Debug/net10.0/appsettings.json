{
  "UserService": {
    "BaseUrl": "http://localhost:5129"
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "users",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },

      "events": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events/{**catch-all}" }
      },

      "rooms": {
        "ClusterId": "events",
        "Match": { "Path": "/api/rooms/{**catch-all}" }
      },

      "reservations": {
        "ClusterId": "reservations",
        "Match": { "Path": "/api/reservations/{**catch-all}" }
      },

      "interests": {
        "ClusterId": "interests",
        "Match": { "Path": "/api/interests/{**catch-all}" }
      }
    },

    "Clusters": {
      "users": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5129/" }
        }
      },
      "events": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5041/" }
        }
      },
      "reservations": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5239/" }
        }
      },
      "interests": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5250/" }
        }
      }
    }
  }
}