{
  "MongoDb": {
    "ConnectionString": "mongodb://admin:password123@localhost:27017/?authSource=admin",
    "DatabaseName": "BookingDB",
    "UsersCollection": "users"
  },
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "Service": {
    "Name": "user-service", "Host": "host.docker.internal", "Port": 5129
  },
  "Jwt": {
    "Issuer": "UserService",
    "Audience": "BookingClient",
    "Key": "CHANGE_ME_SUPER_LONG_SECRET_KEY_32+_CHARS",
    "ExpiresMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
